{
  "python.defaultInterpreterPath": "${workspaceFolder}/estimador-cag/.venv/bin/python",
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.extraPaths": ["${workspaceFolder}/estimador-cag"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
